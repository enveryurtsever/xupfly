# App
PORT=3003
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3003

# Cron Job Authentication (required, at least 16 chars)
CRON_SECRET=change-me-generate-with-openssl-rand-hex-32

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=xupfly
DB_PASSWORD=your_strong_db_password
DB_NAME=xupfly

# X (Twitter) API v2 OAuth 2.0
X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret
X_CALLBACK_URL=http://localhost:3003/api/auth/x/callback

# AI & Media Providers
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FAL_KEY=your_fal_ai_api_key
RAPIDAPI_KEY=your_rapidapi_key

# Initial Admin Seed (optional; random password generated if omitted)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
